{
  "name": "AI for Science",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "postCreateCommand": "pip install -r services/api/requirements.txt && npm install",
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": {"label": "Web", "onAutoForward": "openPreview"},
    "8000": {"label": "API", "onAutoForward": "notify"}
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
