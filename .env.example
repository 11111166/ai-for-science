# Runtime
APP_ENV=development
AUTH_PROVIDER=dev
DATABASE_URL=sqlite:///./drug_discovery.db
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: multimodal process intake (OpenAI-compatible endpoint)
INTAKE_MODEL_BASE=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
INTAKE_TEXT_MODEL=deepseek-ai/DeepSeek-V4-Flash
INTAKE_VL_MODEL=deepseek-ai/DeepSeek-OCR
INTAKE_OCR_MODEL=deepseek-ai/DeepSeek-OCR
INTAKE_VISION_MODE=auto

# Frontend
NEXT_PUBLIC_APP_BASE_PATH=
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1/drug-discovery
APP_BASE_PATH=
